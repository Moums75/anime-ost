# Copie ce fichier en ".env" puis remplace les valeurs (le .env n'est jamais commité).
# Générer un secret : python -c "import secrets; print(secrets.token_hex(32))"

# --- Partagé : clé que le BFF envoie aux API Python (en-tête X-Internal-Key)
INTERNAL_API_KEY=change-moi

# --- API Auth
JWT_SECRET=change-moi-avec-au-moins-32-caracteres
JWT_EXPIRES_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
# Blocage temporaire d'un compte après trop d'échecs de connexion
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5

# --- API Métier
COVER_LOOKUP_ENABLED=1
MAX_AUDIO_MB=30
MAX_COVER_MB=5

# --- BFF
# Nombre de tentatives de connexion / inscription par adresse IP et par fenêtre de 15 min
AUTH_RATE_LIMIT=20
